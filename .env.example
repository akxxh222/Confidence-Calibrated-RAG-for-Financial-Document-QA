LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GENERATION_MAX_OUTPUT_TOKENS=1000
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

POSTGRES_USER=ccrag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ccrag
DATABASE_URL=postgresql://ccrag:change_me@localhost:5433/ccrag

SELF_CONSISTENCY_N=5
TOP_K=5
# Probe all 100 IVFFlat lists for exact retrieval on the initial small corpus.
IVFFLAT_PROBES=100

# SEC fair-access identity — must be a real name/email or EDGAR blocks requests
EDGAR_NAME=
EDGAR_EMAIL=
